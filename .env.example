# Optional overrides — compose works with no .env file at all.
# No real secrets exist in this project (docs/THREAT-MODEL.md threat 6);
# this password only guards a database that is unreachable from the host.

# Password for the compose-internal Postgres (default: postgres).
# The postgres image applies it only when the db-data volume is first
# created — changing it after first boot requires `docker compose down -v`.
#POSTGRES_PASSWORD=postgres
